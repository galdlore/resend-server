# Resend Server 設定ファイル

# サーバー待受ポート
PORT=8080

# SQLite データベースファイルの保存先
DATABASE_PATH=./data/mailer.db

# Resend API キー（https://resend.com/api-keys で取得）
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Cloudflare等で取得したデフォルトドメイン名（例: mydomain.com）
DEFAULT_DOMAIN=example.com

# 管理画面ログイン情報
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# セッションCookie署名用シークレットキー（任意の十分長いランダム文字列）
SESSION_SECRET=your-random-session-secret-key-please-change

# Google Drive バックアップ暗号化パスフレーズ（AES-256-GCM用）
BACKUP_ENCRYPTION_KEY=your-secure-backup-passphrase-change-me

# Google Cloud サービスアカウント鍵ファイルパス（JSON形式）
GDRIVE_SERVICE_ACCOUNT_JSON=./data/gdrive-service-account.json

# Google Drive バックアップ保存先フォルダID（Google DriveのURLの末尾の文字列）
GDRIVE_FOLDER_ID=

# 自動バックアップ間隔（分単位、1440 = 24時間）
BACKUP_INTERVAL_MINUTES=1440
